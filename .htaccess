# ============================================================
#  VS Pet Shop — Hostinger (Apache) config
# ============================================================

# ---- Default document ----
DirectoryIndex index.html

# ---- Always declare UTF-8 in the HTTP response header ----
# Every page already has <meta charset="UTF-8"> and modern browsers fall back
# to it correctly when the header omits a charset, so this wasn't visibly
# broken for real visitors — but the live server was sending a bare
# "Content-Type: text/html" with no charset at all, which is technically
# wrong and can trip up stricter tools (crawlers, link-preview scrapers)
# that don't do the same HTML5 meta-sniffing fallback a browser does.
AddDefaultCharset UTF-8

# ---- Force HTTPS + non-www canonical (vspetshop.com, no www) ----
<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---- Legacy URLs from the domain's PREVIOUS owner ----
  # vspetshop.com was previously an Amazon-affiliate WooCommerce store, and
  # those URLs are still in Google's index (verified Sep 2026, e.g.
  # /brand/visit-the-aibors-store/ and /product/xsyg-dog-boots...). They never
  # existed on this site. 410 Gone tells Google they are permanently gone,
  # which de-indexes faster and with fewer retries than the 404 they returned
  # before. Do NOT 301 these to the homepage — redirecting hundreds of
  # irrelevant product URLs to / produces soft-404s, which is its own quality
  # problem. None of these prefixes collide with anything this site serves.
  RewriteRule ^(product|product-category|brand|category|tag|author)(/|$) - [G,L]
  RewriteRule ^wp-(admin|content|includes|login|json)(/|$) - [G,L]
  RewriteRule ^(feed|comments|xmlrpc\.php|wp-sitemap\.xml)(/|$) - [G,L]

  # Canonicalise /index.html and /index to / (the .html-stripping rule below
  # makes all three resolve to the same document; the canonical tag already
  # mitigates it, this just stops them existing as separate URLs at all).
  # MUST come before the stripping rule or /index gets rewritten first.
  RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
  RewriteRule ^ / [L,R=301]

  # Redirect www -> non-www, straight to HTTPS so http://www. is a single hop
  # rather than two (www->https://www->non-www).
  RewriteCond %{HTTP_HOST} ^www\.vspetshop\.com$ [NC]
  RewriteRule ^(.*)$ https://vspetshop.com/$1 [L,R=301]

  # Redirect http -> https (non-www hosts)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Remove trailing .html from URLs (/contact instead of /contact.html)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteCond %{REQUEST_URI} !\.html$
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# ---- GZIP / Brotli compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
  AddOutputFilterByType DEFLATE application/xml text/xml
</IfModule>

# ---- Browser caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  # Hostinger actually serves .js as application/x-javascript, so the rule
  # above never matched and main.js fell back to a 7-day platform default.
  # Verified live: Content-Type: application/x-javascript, max-age=604800.
  # Safe to cache for a year because every asset URL carries ?v=N (see §7).
  ExpiresByType application/x-javascript  "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/font-woff2    "access plus 1 year"
</IfModule>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---- Block public access to internal dev/doc files ----
# The repo (including these files) deploys as-is via Hostinger's Git
# integration, so anything tracked in git ends up in this folder. None of
# these are secret, but none of them need to be directly browsable either.
<FilesMatch "^(CLAUDE\.md|README\.md|\.gitignore|\.htaccess)$">
  Require all denied
</FilesMatch>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(CLAUDE\.md|README\.md|\.gitignore|\.htaccess)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# ---- Custom 404 ----
ErrorDocument 404 /404.html

# ---- Fonts are self-hosted (see CSS §0) ----
# Make sure the woff2 MIME type is correct regardless of server defaults;
# a wrong type makes some browsers refuse the font and silently fall back.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
